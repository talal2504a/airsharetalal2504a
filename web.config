<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<system.webServer>
		<handlers>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
		</handlers>

		<aspNetCore processPath="dotnet"
					arguments=".\AirShare.dll"
					stdoutLogEnabled="false"
					stdoutLogFile=".\logs\stdout"
					hostingModel="OutOfProcess">

			<!-- Production environment force karo (SSL + security headers) -->
			<environmentVariables>
				<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
			</environmentVariables>
		</aspNetCore>

		<!-- SIZE LIMIT #3 (pehli do: Program.cs FormOptions + Kestrel) -->
		<security>
			<requestFiltering>
				<requestLimits>
					<!-- 25 MB bytes me: 26214400 -->
					<maxAllowedContentLength>26214400</maxAllowedContentLength>
				</requestLimits>
			</requestFiltering>
		</security>

		<httpProtocol>
			<customHeaders>
				<add name="X-Content-Type-Options" value="nosniff" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<add name="Referrer-Policy" value="no-referrer" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>

</configuration>