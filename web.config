<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<system.webServer>
		<handlers>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
		</handlers>

		<!--
      NOTE: hostingModel attribute YAHAN NAHI hai.
      Wo sirf Windows + .NET Framework me valid tha — .NET 6+ me invalid hai
      ("The Enumeration constraint failed" error deta hai).
    -->
		<aspNetCore processPath="dotnet"
					arguments=".\AirShare.dll"
					stdoutLogEnabled="false"
					stdoutLogFile=".\logs\stdout">

			<environmentVariables>
				<!-- Production me force: HTTPS redirect + security headers on -->
				<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
			</environmentVariables>
		</aspNetCore>

		<!-- SIZE LIMIT #3 (pehli do: Program.cs FormOptions + Kestrel) -->
		<security>
			<requestFiltering>
				<!--
          NOTE: maxAllowedContentLength <requestLimits> KE ANDAR attribute hai,
          <requestLimits> element ke andar — seedha <requestFiltering> ke niche nahi.
          (galat nesting se "invalid child element" error aata hai)

          26214400 bytes = 25 MB
        -->
				<requestLimits maxAllowedContentLength="26214400" />
			</requestFiltering>
		</security>

		<httpProtocol>
			<customHeaders>
				<add name="X-Content-Type-Options" value="nosniff" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<add name="Referrer-Policy" value="no-referrer" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>

</configuration>