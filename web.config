<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <!--
      Framework-dependent publish: hosting ke .NET runtime me se chalta hai,
      isliye processPath="dotnet" + arguments se DLL load hoti hai.
    -->
    <aspNetCore processPath="dotnet"
                arguments=".\AirShare.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

    <!-- SIZE LIMIT #3 (pehli do: Program.cs FormOptions + Kestrel) -->
    <security>
      <requestFiltering>
        <!-- 26214400 bytes = 25 MB -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>