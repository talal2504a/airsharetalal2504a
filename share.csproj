<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<!-- Spec ke mutabik net8.0. (.NET 10 SDK reference packs khud le leta hai) -->
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Project ka folder "share" hai, par code ka namespace AirShare rahega -->
		<RootNamespace>AirShare</RootNamespace>
		<AssemblyName>AirShare</AssemblyName>

		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.35" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- App_Data me user files aate hain — compile/publish se bahar rakho -->
		<Compile Remove="App_Data\**" />
		<Content Remove="App_Data\**" />
		<None Remove="App_Data\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- Solution Explorer me dikhane ke liye -->
		<Folder Include="App_Data\uploads\" />
		<Folder Include="Database\" />
	</ItemGroup>

</Project>