{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=AirShare;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },

  "AirShare": {
    "MaxFileSizeBytes": 26214400,
    "MaxActiveSharesPerIp": 10,
    "MaxTextLength": 20000,
    "AllowedExpiryMinutes": [ 10, 15, 30, 60 ],
    "DefaultExpiryMinutes": 15,
    "CleanupIntervalSeconds": 60,
    "UploadRateLimitPerMinute": 10,
    "DownloadRateLimitPerMinute": 60,
    "UploadsFolder": "App_Data/Uploads",
    "BlockedExtensions": [ ".exe", ".bat", ".cmd", ".com", ".scr", ".pif", ".msi", ".msp", ".ps1", ".js", ".jse", ".vbs", ".vbe", ".wsf", ".wsh", ".hta", ".jar", ".lnk", ".reg", ".cpl", ".msc" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AirShare": "Information"
    }
  },
  "AllowedHosts": "*"
}